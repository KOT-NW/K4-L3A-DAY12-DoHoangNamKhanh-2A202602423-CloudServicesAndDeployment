# Core
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Upstash Redis (REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Set ONE of the two below for JWT verification.
# Legacy projects sign JWTs with a shared secret (HS256):
SUPABASE_JWT_SECRET=
# New projects expose a JWKS endpoint (RS256/ES256). Defaults to
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json when left empty:
SUPABASE_JWKS_URL=

# Security / abuse controls
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_IP_PER_MINUTE=120
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_SECONDS=900
MONTHLY_BUDGET_USD=10.0

# Internal agent service (P1+). Leave empty for P0.
AGENT_INTERNAL_URL=
INTERNAL_TOKEN=
